#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || { cd "$(dirname "$0")/../.." && pwd; })"
README="$REPO_ROOT/README.md"

# --- Update skill count in README ---
SKILL_COUNT=$(find "$REPO_ROOT/registry" -name '*.yaml' -type f | wc -l | tr -d ' ')
CURRENT=$(sed -n '/<!-- skills-count-start -->/,/<!-- skills-count-end -->/{ s|.*badge/skills-\([0-9]*\)-.*|\1|p; }' "$README")

if [ "$SKILL_COUNT" != "$CURRENT" ]; then
  sed "/<!-- skills-count-start -->/,/<!-- skills-count-end -->/{ s|badge/skills-[0-9]*-|badge/skills-${SKILL_COUNT}-|; s|alt=\"[0-9]* skills\"|alt=\"${SKILL_COUNT} skills\"|; }" "$README" > "$README.tmp" && mv "$README.tmp" "$README"
  git add "$README"
  echo "Updated README skill count: $CURRENT → $SKILL_COUNT"
fi

# --- Lint staged registry YAML ---
if ! command -v uv >/dev/null 2>&1; then
  echo "uv is required to run registry linting"
  exit 2
fi

STAGED_YAML=$(git diff --cached --name-only --diff-filter=ACM -- 'registry/*.yaml' 'registry/**/*.yaml') || true

if [ -z "$STAGED_YAML" ]; then
  exit 0
fi

echo "Linting staged registry YAML files..."
# shellcheck disable=SC2086
uv run python "$REPO_ROOT/scripts/lint_registry.py" $STAGED_YAML

# --- CUE schema validation for staged registry YAML ---
if command -v cue >/dev/null 2>&1; then
  echo "Validating staged registry YAML files against schema..."
  # shellcheck disable=SC2086
  bash "$REPO_ROOT/scripts/validate.sh" $STAGED_YAML
else
  echo "Warning: cue not installed — skipping schema validation. Install with: brew install cue-lang/tap/cue"
fi
